{
  "name": "nbr.haus",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:token": "GITHUB_PAT=pass://Nik/.env/GITHUB_PAT pass-cli run -- vite dev --port 3000",
    "build": "vite build",
    "serve": "vite preview",
    "serve:host": "npm run build && vite preview --host --port 3000",
    "generate:og-image": "node scripts/generate-og-image.ts",
    "generate:audio": "ELEVENLABS_API_KEY=pass://Nik/.env/ELEVENLABS_API_TOKEN pass-cli run -- node scripts/generate-study-audio.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:token": "GITHUB_LOG=on GITHUB_PAT=pass://Nik/.env/GITHUB_PAT pass-cli run -- playwright test",
    "check:format": "oxfmt --check",
    "format": "oxfmt",
    "check:lint": "eslint .",
    "lint": "eslint --fix .",
    "lint:inspect": "eslint --inspect-config",
    "check:compile": "tsc --noEmit",
    "check:stories": "node scripts/check-story-only.ts",
    "check": "npm run check:format && npm run check:lint && npm run check:compile && npm run check:stories && npm run knip",
    "knip": "knip",
    "storybook": "storybook dev -p 6006 -c src/storybook",
    "build:storybook": "storybook build -c src/storybook",
    "docs:ai:ts-router": "rm -f docs/ai/tanstack-router.md && vibe-rules install claude-code @tanstack/react-router --target docs/ai/tanstack-router.md",
    "pretest": "playwright install chromium"
  },
  "dependencies": {
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-hotkeys": "^0.13.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.42",
    "gray-matter": "^4.0.3",
    "nitro": "3.0.260903-beta",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@elevenlabs/elevenlabs-js": "^2.71.0",
    "@eslint/compat": "2.1.1",
    "@eslint/css": "2.0.0",
    "@eslint/js": "9.39.5",
    "@eslint/json": "2.1.0",
    "@eslint/markdown": "8.0.3",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/addon-onboarding": "^10.0.8",
    "@storybook/addon-vitest": "^10.0.8",
    "@storybook/react-vite": "^10.0.8",
    "@tanstack/devtools-vite": "0.8.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.0.8",
    "globals": "17.13.0",
    "h3": "^2.0.1-rc.6",
    "jsdom": "30.1.1",
    "knip": "6.39.0",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "playwright": "^1.56.1",
    "storybook": "^10.0.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vibe-rules": "^0.3.91",
